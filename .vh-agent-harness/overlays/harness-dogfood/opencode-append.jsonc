{
  // harness-dogfood overlay pack (PROJECT-LOCAL / dogfood) — agent metadata for
  // `harness-release-readiness`. Permission content (permission.bash /
  // permission.task) for this agent is emitted by the Go-native permission
  // emitter (internal/permconfig), which reads this pack's permission-pack.jsonc
  // (materialized under .opencode/sys-scripts/permission-packs/harness-dogfood.jsonc)
  // and overwrites the permission block authoritatively. The EMPTY placeholder
  // objects below let a plain deep-merge produce a structurally-valid
  // `agent.harness-release-readiness` block with a `permission` object the
  // emitter then overwrites — they intentionally carry no real permission
  // decisions (do not edit permissions here; edit permission-pack.jsonc).
  //
  // CRITICAL — prompt form: the `prompt` field MUST be the {file:...} reference
  // form (NOT a bare path). The render validator's promptFileRefRe
  // (internal/cli/ref_validate.go, anchored to ^\{file:(.+)\}$) skips bare-path
  // literals entirely, bypassing prompt-file validation — the A-F1 block that
  // bit the release pack. This mirrors the 20 core agents and the release pack.
  // Steps lineage (recorded 2026-10): operator decision — the core template
  // now ships a uniform `steps: 10000` dead-man backstop on every capped
  // agent, replacing the old 50/40/30/20 tier pattern. This supersedes and
  // REMOVES this pack's local researcher→50 override (64d4d53, 2026-10-01):
  // researcher inherits the core backstop, so this pack carries NO researcher
  // steps key (omission inherits core; a re-added key would pin below or
  // above the backstop). Origin history: trueai 6/8 → silent ~10x retune
  // 2026-05-03 (3f6d0696, no recorded rationale) → frozen into corpus
  // (07b05c7). A steps value is an iteration fence, not a spend, wall-clock,
  // or permission limit; consumers wanting tighter per-agent budgets override
  // via their own overlay append. Deep-merge note: with no researcher key
  // here, the merge adds nothing to researcher's core block.
  "agent": {
    "harness-release-readiness": {
      "description": "Harness release-readiness reporter (dogfood) — read-only orchestrator ABOVE the existing tag-driven releaser; answers 'is vh-agent-harness ready to hand off to releaser?' via a G0–G7 evidence checklist. Never tags/commits/pushes; edits ONLY the release-readiness-pass artifact at .vh-agent-harness/release-readiness-pass.json.",
      "mode": "subagent",
      "color": "accent",
      "prompt": "{file:.opencode/agents/harness-release-readiness.md}",
      "permission": {
        "bash": { "__placeholder__": "deny" },
        "task": { "__placeholder__": "deny" },
        "edit": "deny"
      }
    }
  }
}
